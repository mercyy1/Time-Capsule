# Base URL of the TimeCapsule API, without a trailing slash.
# Copy this file to .env for local development.
VITE_API_URL=http://localhost:5000

# The security check on signup and "forgot password" (Cloudflare Turnstile): the
# widget's site key, from the Cloudflare dashboard. Leave it empty locally to turn
# the check off (then leave the API's TURNSTILE_SECRET_KEY empty too), or use
# Cloudflare's test site key 1x00000000000000000000AA (always passes) with the
# API's test secret key. Required, and test keys refused, when Cloudflare Pages
# builds the site.
# VITE_TURNSTILE_SITE_KEY=
