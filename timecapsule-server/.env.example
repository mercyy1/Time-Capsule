# Copy this file to .env and fill it in. The server checks these variables when it
# starts and refuses to run, listing what to fix, if any are missing or invalid.
# Tests don't read this file (see TEST_DATABASE_URL below).

# PostgreSQL connection string. This one matches docker-compose.yml. Use 127.0.0.1,
# not localhost: localhost tries IPv6 (::1) first, where the database doesn't
# listen, and on Windows every new connection then waits about 2 seconds.
DATABASE_URL="postgresql://timecapsule:timecapsule@127.0.0.1:5432/timecapsule"

# Signs login tokens: at least 32 random characters, never shared or committed.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional (defaults shown)
PORT=5000
# Origin of the web client allowed to call the API (required when NODE_ENV=production).
# Several are allowed, separated by commas: "https://example.com,https://example.pages.dev"
CLIENT_ORIGIN="http://localhost:3000"
# How many proxies in front of the server add the caller's address to the
# X-Forwarded-For header (0 = none, as in local development). Rate limits count
# requests per address, so it must match the host: too low and all visitors share
# one count, too high and anyone can fake their address.
TRUST_PROXY=0
# development, test or production
# NODE_ENV=development

# Emails (required when NODE_ENV=production). Without RESEND_API_KEY the server
# prints each email in its log instead of sending it, links included, which is
# all local development needs.
# The web client's address, used for the links in emails.
APP_URL="http://localhost:3000"
# Who emails come from; its domain must be verified in Resend.
# EMAIL_FROM="TimeCapsule <capsules@example.com>"
# From Resend's dashboard (API Keys, "Sending access" is enough).
# RESEND_API_KEY=
# How many emails the provider allows per day, counted in UTC (Resend's free
# plan: 100). Account emails (address confirmations, password resets) may use
# half of it, unlock emails 90%, and one owner's unlock emails a quarter.
EMAIL_DAILY_LIMIT=100

# The unlock-email job. A scheduler (cron-job.org) runs it by calling
# POST /jobs/unlock-emails with "Authorization: Bearer <JOB_SECRET>". Leave it
# empty locally (the endpoint is then off) and run `npm run job:unlock-emails`.
# Generate one like JWT_SECRET (required when NODE_ENV=production).
# JOB_SECRET=

# Used only by `npm test`, which deletes all data in it. Its name must end in _test.
# TEST_DATABASE_URL="postgresql://timecapsule:timecapsule@127.0.0.1:5432/timecapsule_test"
