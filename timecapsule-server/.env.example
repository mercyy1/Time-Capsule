# Copy this file to .env and fill it in. The server checks these variables when it
# starts and refuses to run, listing what to fix, if any are missing or invalid.
# Tests don't read this file (see TEST_DATABASE_URL below).

# PostgreSQL connection string. This one matches docker-compose.yml. Use 127.0.0.1,
# not localhost: localhost tries IPv6 (::1) first, where the database doesn't
# listen, and on Windows every new connection then waits about 2 seconds.
DATABASE_URL="postgresql://timecapsule:timecapsule@127.0.0.1:5432/timecapsule"

# Signs login tokens: at least 32 random characters, never shared or committed.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional (defaults shown)
PORT=5000
# Origin of the web client allowed to call the API (required when NODE_ENV=production).
CLIENT_ORIGIN="http://localhost:3000"
# development, test or production
# NODE_ENV=development

# Used only by `npm test`, which deletes all data in it. Its name must end in _test.
# TEST_DATABASE_URL="postgresql://timecapsule:timecapsule@127.0.0.1:5432/timecapsule_test"
